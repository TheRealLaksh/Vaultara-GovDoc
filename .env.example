# Firebase web app configuration (Console > Project settings > Your apps).
# These values are public identifiers, not secrets. Security comes from the rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region the Cloud Functions are deployed to (must match functions/src/runtime.js).
VITE_FUNCTIONS_REGION=asia-south1

# Set to true to talk to the local Firebase emulators instead of the cloud.
VITE_USE_EMULATORS=false
