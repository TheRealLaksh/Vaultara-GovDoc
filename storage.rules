rules_version = '2';

// Clients may only drop a new file into their own inbox. They can never read,
// overwrite or delete anything. The Cloud Function `finalizeUpload` validates
// the file, encrypts it into vault/, and removes the inbox copy. vault/ is
// closed to every client; files are only served by the `download` function.
service firebase.storage {
  match /b/{bucket}/o {

    match /inbox/{uid}/{fileId} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && fileId.matches('^[A-Za-z0-9_-]{20,40}$')
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024;
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
