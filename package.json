{
  "name": "vaultara",
  "version": "2.0.0",
  "description": "Vaultara: a private, encrypted vault for government documents with family sharing.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project vaultara-rules-test \"vitest run -c vitest.rules.config.js\"",
    "test:functions": "npm --prefix functions test",
    "check": "node scripts/check-text.mjs",
    "deploy": "npm run build && firebase deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheRealLaksh/Vaultara-GovDoc.git"
  },
  "bugs": {
    "url": "https://github.com/TheRealLaksh/Vaultara-GovDoc/issues"
  },
  "homepage": "https://github.com/TheRealLaksh/Vaultara-GovDoc#readme",
  "dependencies": {
    "firebase": "^12.19.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.34.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
